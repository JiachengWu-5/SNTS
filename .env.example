# Copy this file to .env and fill in paths for your own machine.
# start.bat / start.sh will load .env if it exists.
# The writing page binds to 127.0.0.1 by default.

# Works directory. If unset, defaults to the current user's home Article folder
# (Windows: %USERPROFILE%\Article , Linux/macOS: ~/Article).
# NOVEL_WRITER_ARTICLE_ROOT=
# NOVEL_WRITER_TEMPLATE_DIR=
# NOVEL_WRITER_LLM_URL=http://127.0.0.1:8080
# NOVEL_WRITER_CONTEXT_TOKENS=65536
# NOVEL_WRITER_HOST=127.0.0.1
# NOVEL_WRITER_PORT=8765

# Required when the app starts or stops llama-server during illustration sessions.
# Use placeholder-style paths on your own machine, for example:
# NOVEL_WRITER_LLAMA_EXE=C:\llama.cpp\llama-server.exe
# NOVEL_WRITER_LLAMA_MODEL=C:\models\Qwen3.8-27B-UD-Q5_K_M.gguf

# Optional custom script to start llama-server. Leave unset to use the two variables above.
# NOVEL_WRITER_LLAMA_RESTART=

# Optional ComfyUI paths for scene illustrations:
# NOVEL_WRITER_COMFY_URL=http://127.0.0.1:8188
# NOVEL_WRITER_COMFY_ROOT=C:\ComfyUI
# NOVEL_WRITER_COMFY_PYTHON=
# NOVEL_WRITER_COMFY_WORKFLOW=

# Optional log directory for llama-server / ComfyUI when started by the app.
# Defaults to a "shanydoc" folder under the system temp directory.
# NOVEL_WRITER_LOG_DIR=
